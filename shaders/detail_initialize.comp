#version 430
#include "common.glsl"
layout(binding=0) uniform sampler3D parentState;
layout(rgba32f,binding=0) writeonly uniform image3D outputState;
void main(){int n=invocationIndex();if(n>=cells(dims))return;ivec3 g=coord3(n,dims);imageStore(outputState,g,textureLod(parentState,(vec3(g)+.5)/vec3(dims),0.));}
