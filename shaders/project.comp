#version 430
#include "common.glsl"

#ifdef NATIVE_FIELDS
layout(rgba32f,binding=8)  uniform image3D field_velocity;
vec4 load_velocity(int n){return imageLoad(field_velocity,coord3(n,imageSize(field_velocity)));}
void store_velocity(int n,vec4 value){imageStore(field_velocity,coord3(n,imageSize(field_velocity)),value);}
#else
layout(std430,binding=0) buffer V {vec4 velocity[];};
vec4 load_velocity(int n){return velocity[n];}
void store_velocity(int n,vec4 value){velocity[n]=value;}
#endif

layout(std430,binding=1) readonly buffer P {float pressure[];};
layout(std430,binding=2) writeonly buffer R {float rhs[];};
uniform int operation;
void main(){
 int n=invocationIndex();
 if(operation==0){
  if(n>=cells(dims))return;ivec3 g=coord3(n,dims);float div=0.;
  for(int a=0;a<3;a++){ivec3 b=g;b[a]++;div+=load_velocity(index3(b,dims+1))[a]-load_velocity(index3(g,dims+1))[a];}
  rhs[n]=-div*spacing;
 }else{
  if(n>=cells(dims+1))return;ivec3 g=coord3(n,dims+1);vec4 v=load_velocity(n);
  for(int a=0;a<3;a++){
   ivec3 vd=dims;vd[a]++;if(any(greaterThanEqual(g,vd))){v[a]=0.;continue;}
   if(a==1&&g.y==0){v[a]=0.;continue;}
   ivec3 lo=g;lo[a]--;ivec3 hi=g;
   float pl=0.,ph=0.;
   if(lo[a]>=0)pl=pressure[index3(lo,dims)];if(hi[a]<dims[a])ph=pressure[index3(hi,dims)];
   if(lo[a]<0)pl=-ph;if(hi[a]>=dims[a])ph=-pl;
   v[a]-=(ph-pl)/spacing;
  }store_velocity(n,v);
 }
}
