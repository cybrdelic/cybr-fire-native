#version 430
#include "common.glsl"
layout(std430,binding=0) readonly buffer P {float p[];};
layout(std430,binding=1) readonly buffer R {float rhs[];};
layout(std430,binding=2) writeonly buffer O {float outP[];};
uniform int operation; // 0 smooth,1 residual,2 restrict residual,3 prolong-add
uniform ivec3 otherDims;
float diagonal(ivec3 g){
 float d=0.;for(int a=0;a<3;a++){
  d+=g[a]>0?1.:(a==1?0.:2.);d+=g[a]<dims[a]-1?1.:2.;
 }return d;
}
float neighborSum(ivec3 g){float s=0.;for(int a=0;a<3;a++){
 ivec3 q=g;q[a]--;if(q[a]>=0)s+=p[index3(q,dims)];q=g;q[a]++;if(q[a]<dims[a])s+=p[index3(q,dims)];
 }return s;
}
float coarseAt(ivec3 g){
 float sign=1.;for(int a=0;a<3;a++){
  if(g[a]<0){g[a]=0;if(a!=1)sign=-sign;}
  if(g[a]>=otherDims[a]){g[a]=otherDims[a]-1;sign=-sign;}
 }return sign*rhs[index3(g,otherDims)];
}
void main(){
 int n=invocationIndex();if(n>=cells(dims))return;ivec3 g=coord3(n,dims);
 if(operation==0)outP[n]=mix(p[n],(neighborSum(g)+rhs[n])/diagonal(g),.8);
 else if(operation==1)outP[n]=rhs[n]-(diagonal(g)*p[n]-neighborSum(g));
 else if(operation==2){
  float sum=0.;for(int k=0;k<2;k++)for(int j=0;j<2;j++)for(int i=0;i<2;i++)sum+=rhs[index3(g*2+ivec3(i,j,k),otherDims)];
  outP[n]=sum*.5; // 4*h scaling times 1/8 volume average
 }else{
  vec3 q=(vec3(g)+.5)*.5-.5;ivec3 b=ivec3(floor(q));vec3 t=fract(q);float val=0.;
  for(int k=0;k<2;k++)for(int j=0;j<2;j++)for(int i=0;i<2;i++){
   ivec3 s=ivec3(i,j,k);vec3 w=mix(1.-t,t,vec3(s));val+=w.x*w.y*w.z*coarseAt(b+s);
  }outP[n]=p[n]+val;
 }
}
