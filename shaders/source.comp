#version 430
#include "common.glsl"

#ifdef NATIVE_FIELDS
layout(rgba32f,binding=8)  uniform image3D field_state;
vec4 load_state(int n){return imageLoad(field_state,coord3(n,imageSize(field_state)));}
void store_state(int n,vec4 value){imageStore(field_state,coord3(n,imageSize(field_state)),value);}
#else
layout(std430,binding=0) buffer Q {vec4 state[];};
vec4 load_state(int n){return state[n];}
void store_state(int n,vec4 value){state[n]=value;}
#endif


#ifdef NATIVE_FIELDS
layout(rgba32f,binding=9)  uniform image3D field_velocity;
vec4 load_velocity(int n){return imageLoad(field_velocity,coord3(n,imageSize(field_velocity)));}
void store_velocity(int n,vec4 value){imageStore(field_velocity,coord3(n,imageSize(field_velocity)),value);}
#else
layout(std430,binding=1) buffer V {vec4 velocity[];};
vec4 load_velocity(int n){return velocity[n];}
void store_velocity(int n,vec4 value){velocity[n]=value;}
#endif

layout(std430,binding=2) readonly buffer S {vec4 sources[];};
uniform int sourceCount;
uniform float time;
uniform int operation;
// Each source: center+start; radii+end; composition; velocity+replacement rate;
//             modulation amplitude, frequency, seed, swirl.
// The envelope is integrated over the accepted tick, including fractional
// start/end crossings. Ramps never depend on capture cadence.
float exchangeAlpha(float x){return x<.05?x*(1.-x*(.5-x*(1./6.-x*(1./24.-x/120.)))):1.-exp(-x);}
float rampPrimitive(float u){return u*u*u*(1.-.5*u);}
float envelope(int s){
 float start=sources[s*8].w,end=sources[s*8+1].w;
 vec2 ramp=sources[s*8+6].xy;
 if(time>=start+ramp.x&&time+dt<=end-ramp.y)return 1.;
 float lo=max(time,start),hi=min(time+dt,end);
 if(hi<=lo)return 0.;
 float result=0.;
 if(ramp.x>0.){
  float a=clamp((lo-start)/ramp.x,0.,1.),b=clamp((hi-start)/ramp.x,0.,1.);
  result+=ramp.x*(rampPrimitive(b)-rampPrimitive(a));
 }
 result+=max(0.,min(hi,end-ramp.y)-max(lo,start+ramp.x));
 if(ramp.y>0.){
  float a=clamp((end-hi)/ramp.y,0.,1.),b=clamp((end-lo)/ramp.y,0.,1.);
  result+=ramp.y*(rampPrimitive(b)-rampPrimitive(a));
 }
 return result/max(dt,1.e-20);
}
vec3 sourceCenter(int s){
 return sources[s*8].xyz+sources[s*8+7].xyz*(time+.5*dt-sources[s*8].w);
}
float weight(int s,vec3 p){
 vec4 c=sources[s*8],r=sources[s*8+1];vec3 dynamicR=r.xyz+vec3(sources[s*8+5].w*max(0.,time+.5*dt-c.w));vec3 q=(p-sourceCenter(s))/dynamicR;
 return pow(max(0.,1.-dot(q,q)),2.);
}
float rateAt(int s,vec3 p){
 vec4 c=sources[s*8],r=sources[s*8+1];
 float temporalWeight=envelope(s);if(temporalWeight<=0.)return 0.;
 vec4 m=sources[s*8+4];vec3 x=(p-sourceCenter(s))/(r.xyz+vec3(sources[s*8+5].w*max(0.,time+.5*dt-c.w)));
 float support=weight(s,p);if(support<=0.)return 0.;
 float perturb=sin(5.3*x.x+2.1*x.z+time*m.y+m.z)*sin(3.7*x.z-2.3*x.x-time*m.y*.73);
 return sources[s*8+3].w*support*temporalWeight*(1.+m.x*perturb);
}
vec3 inletTurbulence(int s,vec3 p){
 vec4 t=sources[s*8+5];float seed=sources[s*8+4].z;
 vec3 x=p/max(t.y,.001);float phase=time/max(t.z,.001);
 // A sum of polarized transverse Fourier modes: every mode has k dot a=0.
 // These perturb MOMENTUM in the emitter. There is no render-time noise.
 vec3 value=vec3(0.);
 for(int k=0;k<4;k++){
  float a=float(k)+1.;
  vec3 wave=normalize(vec3(sin(a*3.1+seed),cos(a*5.7+seed),sin(a*7.3-seed)));
  vec3 pol=normalize(cross(wave,vec3(.37,.81,.44)));
  float frequency=6.2831853*pow(1.7,float(k));
  value+=pol*sin(dot(wave,x)*frequency+phase*(1.+.31*a)+seed)*pow(.65,float(k));
 }return t.x*value;
}
void main(){
 int n=invocationIndex();
 if(operation==0){
  if(n>=cells(dims))return;vec3 p=(vec3(coord3(n,dims))+.5)*spacing;
  float r=0.;vec4 sum=vec4(0);
  for(int s=0;s<sourceCount;s++){float w=rateAt(s,p);r+=w;sum+=w*sources[s*8+2];}
  if(r>0.)store_state(n,fma(sum/r-load_state(n),vec4(exchangeAlpha(r*dt)),load_state(n)));
 }else{
  if(n>=cells(dims+1))return;ivec3 g=coord3(n,dims+1);vec4 v=load_velocity(n);
  for(int a=0;a<3;a++){
   ivec3 vd=dims;vd[a]+=1;if(any(greaterThanEqual(g,vd)))continue;
   vec3 p=(vec3(g)+faceOffset(a))*spacing;float r=0.,sum=0.;
   for(int s=0;s<sourceCount;s++){
    float w=rateAt(s,p);vec3 delta=p-sourceCenter(s);
    vec3 target=sources[s*8+3].xyz+sources[s*8+7].xyz+sources[s*8+4].w*vec3(-delta.z,0.,delta.x);
    float radialSpeed=sources[s*8+6].z;
    if(radialSpeed>0.)target+=radialSpeed*normalize(delta+vec3(1.e-6));
    if(w>0.)target+=inletTurbulence(s,p);
    r+=w;sum+=w*target[a];
   }if(r>0.)v[a]=fma(sum/r-v[a],exchangeAlpha(r*dt),v[a]);
   if(a==1&&g.y==0)v.y=0.;
  }store_velocity(n,v);
 }
}
