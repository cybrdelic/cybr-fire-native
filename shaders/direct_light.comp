#version 430
#include "common.glsl"
#include "solids.glsl"
layout(binding=0) uniform sampler3D opticalTexture;
layout(rgba32f,binding=7) writeonly uniform image3D directTexture;
uniform ivec3 volumeDims;
uniform vec3 keyDirection;
uniform float keyIntensity,shadowStep;
void main(){
 int n=invocationIndex();if(n>=cells(dims))return;ivec3 g=coord3(n,dims);
 if(keyIntensity==0.){imageStore(directTexture,g,vec4(1.));return;}
 vec3 size=vec3(volumeDims)*spacing,p=(vec3(g)+.5)/vec3(dims)*size,rd=normalize(keyDirection);
 int which;float hit=firstSolidHit(p,rd,which);
 if(solidDistance(p)<0.||hit<1.e19){imageStore(directTexture,g,vec4(0.));return;}
 float end=1.e20;for(int a=0;a<3;a++)if(abs(rd[a])>1.e-9)end=min(end,((rd[a]>0.?size[a]:0.)-p[a])/rd[a]);
 float ds=spacing*shadowStep,tau=0.;
 for(float t=0.;t<end;t+=ds){float len=min(ds,end-t);tau+=textureLod(opticalTexture,(p+rd*(t+.5*len))/size,0.).a*len;if(tau>16.)break;}
 imageStore(directTexture,g,vec4(exp(-tau)));
}
