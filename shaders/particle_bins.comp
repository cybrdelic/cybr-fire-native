#version 430
#include "common.glsl"
struct Particle {vec4 positionRadius;vec4 velocityTemperature;vec4 previousAge;vec4 identity;};
layout(std430,binding=0) readonly buffer P {Particle particles[];};
layout(std430,binding=1) buffer B {vec4 projected[];};
layout(std430,binding=2) buffer C {uint counts[];};
layout(std430,binding=3) buffer I {uint indices[];};
layout(std430,binding=4) readonly buffer L {vec4 lut[];};
uniform int operation,particleCount,tileCapacity;
uniform ivec2 resolution,tileDims;
uniform vec3 cameraPosition,cameraForward,cameraRight,cameraUp;
uniform float tanHalfFov,emissivity;
void main(){
 int n=invocationIndex(),tiles=tileDims.x*tileDims.y;
 if(operation==0){if(n<tiles+1)counts[n]=0u;return;}
 if(n>=particleCount)return;Particle p=particles[n];projected[2*n]=vec4(0.);projected[2*n+1]=vec4(0.);
 if(p.positionRadius.w<=0.)return;vec3 delta=p.positionRadius.xyz-cameraPosition;float depth=dot(delta,cameraForward);
 if(depth<=.01)return;float focal=float(resolution.y)/(2.*tanHalfFov);
 vec2 pixel=vec2(.5*float(resolution.x)+focal*dot(delta,cameraRight)/depth,.5*float(resolution.y)-focal*dot(delta,cameraUp)/depth);
 float radius=focal*p.positionRadius.w/depth,sigma=max(radius*.70710678,.55),amplitude=radius*radius/(2.*sigma*sigma);
 float index=clamp((p.velocityTemperature.w-300.)/5700.*511.,0.,511.);int b=min(int(index),510);
 vec3 color=mix(lut[b].rgb,lut[b+1].rgb,index-float(b))*emissivity;
 projected[2*n]=vec4(pixel,depth,sigma);projected[2*n+1]=vec4(color,amplitude);
 ivec2 lo=max(ivec2(floor((pixel-4.*sigma)/16.)),ivec2(0)),hi=min(ivec2(floor((pixel+4.*sigma)/16.)),tileDims-1);
 for(int y=lo.y;y<=hi.y;y++)for(int x=lo.x;x<=hi.x;x++){
  int tile=x+tileDims.x*y;uint slot=atomicAdd(counts[tile],1u);
  if(slot<uint(tileCapacity))indices[tile*tileCapacity+int(slot)]=uint(n);else atomicAdd(counts[tiles],1u);
 }
}
