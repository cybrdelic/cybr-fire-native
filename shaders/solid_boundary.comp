#version 430
#include "common.glsl"

#ifdef NATIVE_FIELDS
layout(rgba32f,binding=8)  uniform image3D field_q;
vec4 load_q(int n){return imageLoad(field_q,coord3(n,imageSize(field_q)));}
void store_q(int n,vec4 value){imageStore(field_q,coord3(n,imageSize(field_q)),value);}
#else
layout(std430,binding=0) buffer Q {vec4 q[];};
vec4 load_q(int n){return q[n];}
void store_q(int n,vec4 value){q[n]=value;}
#endif


#ifdef NATIVE_FIELDS
layout(rgba32f,binding=9)  uniform image3D field_v;
vec4 load_v(int n){return imageLoad(field_v,coord3(n,imageSize(field_v)));}
void store_v(int n,vec4 value){imageStore(field_v,coord3(n,imageSize(field_v)),value);}
#else
layout(std430,binding=1) buffer V {vec4 v[];};
vec4 load_v(int n){return v[n];}
void store_v(int n,vec4 value){v[n]=value;}
#endif

layout(std430,binding=2) readonly buffer M {float fluid[];};
uniform int operation;
bool insideSolid(ivec3 p){return all(greaterThanEqual(p,ivec3(0)))&&all(lessThan(p,dims))&&fluid[index3(p,dims)]<.5;}
void main(){
 int n=invocationIndex();if(n>=cells(dims+1))return;
 if(n<cells(dims)&&operation==0&&fluid[n]<.5)store_q(n,vec4(0.));
 ivec3 p=coord3(n,dims+1);vec4 value=load_v(n);
 for(int a=0;a<3;a++){
  ivec3 d=dims;d[a]++;if(any(greaterThanEqual(p,d))){value[a]=0.;continue;}
  ivec3 lo=p;lo[a]--;if(insideSolid(lo)||insideSolid(p)||(a==1&&p.y==0))value[a]=0.;
 }store_v(n,value);
}
