#version 430
#include "common.glsl"
layout(std430,binding=1) readonly buffer Surface {vec4 surface[];};
#ifdef NATIVE_FIELDS
layout(rgba32f,binding=8) uniform image3D gas;
vec4 readGas(int n){return imageLoad(gas,coord3(n,dims));}
void writeGas(int n,vec4 v){imageStore(gas,coord3(n,dims),v);}
#else
layout(std430,binding=0) buffer Gas {vec4 gasArray[];};
vec4 readGas(int n){return gasArray[n];}
void writeGas(int n,vec4 v){gasArray[n]=v;}
#endif
uniform float pyrolysisHeat;
uniform float capacity;
void main(){
  int n=invocationIndex();if(n>=cells(dims))return;
  ivec3 g=coord3(n,dims);
  if(g.y>1)return;
  vec4 surf=surface[g.z*dims.x+g.x];
  // Surface mass loss [kg/m²/s] -> volumetric gas fuel [kg/m³].
  float mass=surf.w*dt/(2.*spacing);
  if(mass<=0.)return;
  vec4 q=readGas(n);
  q.x+=mass;
  q.z+=mass*pyrolysisHeat;
  writeGas(n,q);
}
