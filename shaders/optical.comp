#version 430
#include "common.glsl"

#ifdef NATIVE_FIELDS
layout(rgba32f,binding=8) readonly uniform image3D field_state;
vec4 load_state(int n){return imageLoad(field_state,coord3(n,imageSize(field_state)));}
#else
layout(std430,binding=0) readonly buffer Q {vec4 state[];};
vec4 load_state(int n){return state[n];}
#endif

layout(std430,binding=1) readonly buffer LUT {vec4 blackbody[];};
layout(rgba32f,binding=0) writeonly uniform image3D opticalTexture;
uniform float capacity;
uniform float sootExtinction;
uniform float scatterAlbedo;
uniform float lutMaxK;
void main(){
 int n=invocationIndex();if(n>=cells(dims))return;ivec3 g=coord3(n,dims);vec4 q=load_state(n);
 float T=300.+q.z/capacity;float pos=clamp((T-300.)/(lutMaxK-300.)*511.,0.,511.);
 int lo=min(int(pos),510);vec3 B=mix(blackbody[lo].rgb,blackbody[lo+1].rgb,pos-float(lo));
 // Interpolate emission coefficient j and extinction kappa, not B and kappa independently.
 float kappa=max(q.w,0.)*sootExtinction;
 imageStore(opticalTexture,g,vec4(B*kappa*(1.-scatterAlbedo),kappa));
}
